                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha"
          }
        },
        "type": "object",
        "required": [
          "monto"
        ],
        "title": "AbonoIn"
      },
      "ApartadoIn": {
        "properties": {
