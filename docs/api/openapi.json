          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha"
          }
        },
        "type": "object",
        "required": [
          "cliente_id",
          "numero_serie",
          "anticipo"
        ],
        "title": "ApartadoIn"
      },
      "DespachoIn": {
        "properties": {
          "numero_serie": {
            "type": "string",
            "title": "Numero Serie"
          }
        },
        "type": "object",
        "required": [
          "numero_serie"
        ],
        "title": "DespachoIn"
      },
      "DevolucionIn": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "numero_serie": {
            "type": "string",
            "title": "Numero Serie"
          },
          "clave_supervisor": {
            "type": "string",
            "title": "Clave Supervisor",
            "default": ""
          },
          "motivo": {
            "type": "string",
            "title": "Motivo",
            "default": ""
          },
          "empaque_original": {
            "type": "boolean",
            "title": "Empaque Original",
            "default": true
          },
          "accesorios_completos": {
            "type": "boolean",
            "title": "Accesorios Completos",
            "default": true
          },
          "dano_cliente": {
            "type": "boolean",
            "title": "Dano Cliente",
            "default": false
          },
          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha"
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "numero_serie"
        ],
        "title": "DevolucionIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LineaIn": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "numero_serie": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Numero Serie"
          }
        },
        "type": "object",
        "required": [
          "sku"
        ],
        "title": "LineaIn"
      },
      "PagoIn": {
        "properties": {
          "metodo": {
            "type": "string",
            "title": "Metodo"
          },
          "monto": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Monto"
          }
        },
        "type": "object",
        "required": [
          "metodo",
          "monto"
        ],
        "title": "PagoIn"
      },
      "RecepcionIn": {
        "properties": {
          "numero_serie": {
            "type": "string",
            "title": "Numero Serie"
          },
          "sucursal_id": {
            "type": "string",
            "title": "Sucursal Id"
          }
        },
        "type": "object",
        "required": [
          "numero_serie",
          "sucursal_id"
        ],
        "title": "RecepcionIn"
      },
      "TrasladoIn": {
        "properties": {
          "numero_serie": {
            "type": "string",
            "title": "Numero Serie"
          },
          "sucursal_destino": {
            "type": "string",
            "title": "Sucursal Destino"
          },
          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha"
          }
        },
        "type": "object",
        "required": [
          "numero_serie",
          "sucursal_destino"
        ],
        "title": "TrasladoIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VencimientosIn": {
        "properties": {
          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha"
          }
        },
        "type": "object",
        "title": "VencimientosIn"
      },
      "VentaIn": {
        "properties": {
          "sucursal_id": {
            "type": "string",
            "title": "Sucursal Id"
          },
          "lineas": {
            "items": {
              "$ref": "#/components/schemas/LineaIn"
            },
            "type": "array",
            "title": "Lineas"
          },
          "pagos": {
            "items": {
              "$ref": "#/components/schemas/PagoIn"
            },
            "type": "array",
            "title": "Pagos"
          },
          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha"
          }
        },
        "type": "object",
        "required": [
          "sucursal_id",
          "lineas",
          "pagos"
        ],
        "title": "VentaIn"
      }
    }
  }
