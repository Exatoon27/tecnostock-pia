# Copiar a .env (no subir .env). Valores de ejemplo: sin credenciales reales.
# Docker Compose los lee solo; si no existe .env usa los valores por defecto del compose.
POSTGRES_USER=tecnostock
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=tecnostock
APP_PORT=8000
SEED_DATA=1

# Sólo para correr la app fuera de Docker. Vacío = persistencia en memoria.
# Ejemplos: sqlite+pysqlite:///./tecnostock.db
#           postgresql+psycopg://tecnostock:cambiar_en_produccion@localhost:5432/tecnostock
DATABASE_URL=
